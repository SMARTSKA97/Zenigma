# Copy this file to `.env` and fill in the values. `.env` is git-ignored: never commit real secrets.
# Generate random values with:  openssl rand -base64 48
#
# Used by: the API in development (loaded automatically), docker-compose.yml, and tools/generators/words/schedule.mjs.
# In production the same names are set as environment variables on Render / GitHub secrets (see docs/DEPLOYMENT.md).

# --- Local database (docker compose up -d db) ---
POSTGRES_USER=zenigma
POSTGRES_PASSWORD=
POSTGRES_DB=zenigma

# --- API (ASP.NET Core reads these; "__" is the section separator) ---
# Must use the same user/password/database as above.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=zenigma;Username=zenigma;Password=
# Signing key for login tokens, 32+ characters.
Jwt__Key=

# --- Daily puzzle scheduler (tools/generators/words/schedule.mjs) ---
# 16+ characters. Keep it secret and never change it once players are active.
PUZZLE_SEED=

# --- Integration tests (apps/api tests that need a database) ---
ZENIGMA_TEST_DB=Host=localhost;Port=5432;Database=zenigma;Username=zenigma;Password=
